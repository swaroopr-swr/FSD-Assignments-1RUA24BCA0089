<%- include('partials/header') %>

<div class="empty-state glass-card" style="margin-top: 2rem; padding: 4rem 2rem;">
  <div class="empty-state-icon" style="width: 88px; height: 88px; font-size: 2.5rem; background: rgba(236, 72, 153, 0.15); color: var(--secondary);">
    <i class="fa-solid fa-triangle-exclamation"></i>
  </div>

  <h1 style="font-size: 2.5rem; color: var(--text-primary); margin-top: 0.5rem;">404</h1>
  <h2 style="font-size: 1.5rem; color: var(--text-highlight);"><%= typeof title !== 'undefined' ? title : 'Page Not Found' %></h2>
  
  <p style="max-width: 480px; margin: 0 auto; color: var(--text-secondary);">
    The user or resource you are looking for does not exist in the database or the URL path is invalid.
    <% if (typeof path !== 'undefined' && path) { %>
      <br><code style="font-size: 0.8rem; background: rgba(0,0,0,0.3); padding: 4px 8px; border-radius: 6px; margin-top: 0.5rem; display: inline-block;"><%= path %></code>
    <% } %>
  </p>

  <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1rem;">
    <a href="/users" class="btn btn-primary" id="return-home-btn">
      <i class="fa-solid fa-house"></i>
      <span>Back to Users Directory</span>
    </a>
    <a href="/users/new" class="btn btn-secondary">
      <i class="fa-solid fa-user-plus"></i>
      <span>Create User</span>
    </a>
  </div>
</div>

<%- include('partials/footer') %>
