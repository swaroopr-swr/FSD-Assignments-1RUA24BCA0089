<%- include('../partials/header') %>

<div class="breadcrumbs">
  <a href="/users"><i class="fa-solid fa-users"></i> Users</a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
  <a href="/users/<%= user._id %>"><%= user.firstName %> <%= user.lastName || '' %></a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
  <span>Children List</span>
</div>

<div class="page-header">
  <div class="header-title-group">
    <h1><%= user.firstName %>'s Children</h1>
    <p class="subtitle">Filtered query: <code style="color: var(--primary-light);">Child.find({ parentId: '<%= user._id %>' })</code></p>
  </div>

  <div style="display: flex; gap: 0.75rem;">
    <a href="/users/<%= user._id %>/children-new" class="btn btn-primary" id="add-child-btn">
      <i class="fa-solid fa-plus"></i> Add Child
    </a>
    <a href="/users/<%= user._id %>" class="btn btn-secondary">
      <i class="fa-solid fa-arrow-left"></i> Back to Profile
    </a>
  </div>
</div>

<% if (!children || children.length === 0) { %>
  <div class="empty-state glass-card">
    <div class="empty-state-icon">
      <i class="fa-solid fa-child-reaching"></i>
    </div>
    <h3>No children found for this user.</h3>
    <p><%= user.firstName %> does not have any children recorded yet.</p>
    <a href="/users/<%= user._id %>/children-new" class="btn btn-primary">Add First Child</a>
  </div>
<% } else { %>
  <div class="cards-grid">
    <% children.forEach(child => { %>
      <% 
        const initials = ((child.firstName ? child.firstName[0] : '') + (child.lastName ? child.lastName[0] : '')).toUpperCase() || 'C';
      %>
      <div class="glass-card interactive-card child-card">
        <div class="child-card-header">
          <div class="child-title-area">
            <div class="avatar child-avatar"><%= initials %></div>
            <div>
              <h3 style="font-size: 1.15rem;"><%= child.firstName %> <%= child.lastName || '' %></h3>
              <span style="font-size: 0.8rem; color: var(--text-muted); font-family: monospace;">ID: <%= child._id %></span>
            </div>
          </div>
          <span class="badge badge-cyan"><%= child.age %> yrs</span>
        </div>

        <div class="info-list">
          <div class="info-item">
            <i class="fa-regular fa-envelope icon"></i>
            <span><%= child.email || 'No email provided' %></span>
          </div>
          <div class="info-item">
            <i class="fa-solid fa-user-shield icon"></i>
            <span>Parent ID: <code style="font-size: 0.75rem;"><%= child.parentId %></code></span>
          </div>
        </div>

        <div class="user-card-footer" style="margin-top: 0.5rem; gap: 0.5rem;">
          <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn btn-primary btn-sm">
            <i class="fa-solid fa-eye"></i> Details
          </a>
          <a href="/children/<%= child._id %>/edit" class="btn btn-secondary btn-sm">
            <i class="fa-solid fa-pen-to-square"></i> Edit
          </a>
          <form action="/children/<%= child._id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('Delete this child?');">
            <button type="submit" class="btn btn-danger btn-sm">
              <i class="fa-solid fa-trash"></i>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
