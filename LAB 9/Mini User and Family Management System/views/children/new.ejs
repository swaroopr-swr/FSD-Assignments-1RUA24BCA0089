<%- include('../partials/header') %>

<div class="breadcrumbs">
  <a href="/users"><i class="fa-solid fa-users"></i> Users</a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
  <a href="/users/<%= user._id %>"><%= user.firstName %> <%= user.lastName || '' %></a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
  <span>Add Child</span>
</div>

<div class="form-container">
  <div class="glass-card">
    <div class="form-header">
      <div class="avatar child-avatar" style="margin: 0 auto 1rem; width: 64px; height: 64px; font-size: 1.5rem;">
        <i class="fa-solid fa-child"></i>
      </div>
      <h1>Add Child to Family</h1>
      <p>Registering child for parent: <strong style="color: var(--text-primary);"><%= user.firstName %> <%= user.lastName || '' %></strong></p>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="alert alert-danger" id="validation-errors-alert">
        <i class="fa-solid fa-circle-exclamation" style="font-size: 1.25rem; margin-top: 0.1rem;"></i>
        <div>
          <strong>Please correct the following errors:</strong>
          <ul>
            <% errors.forEach(err => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>

    <form action="/users/<%= user._id %>/children" method="POST" id="add-child-form">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="firstName">Child First Name <span class="required-star">*</span></label>
          <div class="input-wrapper">
            <i class="fa-regular fa-user input-icon"></i>
            <input 
              type="text" 
              id="firstName" 
              name="firstName" 
              class="form-input" 
              placeholder="e.g. Aarav" 
              value="<%= typeof values !== 'undefined' && values.firstName ? values.firstName : '' %>"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="lastName">Child Last Name</label>
          <div class="input-wrapper">
            <i class="fa-regular fa-user input-icon"></i>
            <input 
              type="text" 
              id="lastName" 
              name="lastName" 
              class="form-input" 
              placeholder="e.g. Khan" 
              value="<%= typeof values !== 'undefined' && values.lastName ? values.lastName : (user.lastName || '') %>"
            >
          </div>
        </div>
      </div>

      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="age">Age <span class="required-star">*</span></label>
          <div class="input-wrapper">
            <i class="fa-solid fa-cake-candles input-icon"></i>
            <input 
              type="number" 
              id="age" 
              name="age" 
              min="0"
              max="120"
              class="form-input" 
              placeholder="e.g. 7" 
              value="<%= typeof values !== 'undefined' && values.age ? values.age : '' %>"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Child Email</label>
          <div class="input-wrapper">
            <i class="fa-regular fa-envelope input-icon"></i>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-input" 
              placeholder="e.g. aarav@example.com" 
              value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"
            >
          </div>
        </div>
      </div>

      <div class="form-actions">
        <a href="/users/<%= user._id %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" id="submit-child-btn">
          <i class="fa-solid fa-plus"></i>
          <span>Add Child</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
