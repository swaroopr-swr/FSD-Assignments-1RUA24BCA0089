<%- include('../partials/header') %>

<div class="breadcrumbs">
  <a href="/users"><i class="fa-solid fa-users"></i> Users</a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
  <span>Create New User</span>
</div>

<div class="form-container">
  <div class="glass-card">
    <div class="form-header">
      <div class="avatar" style="margin: 0 auto 1rem; width: 64px; height: 64px; font-size: 1.5rem;">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h1>Create User Profile</h1>
      <p>Enter the parent user details to add them to the system</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="alert alert-danger" id="validation-errors-alert">
        <i class="fa-solid fa-circle-exclamation" style="font-size: 1.25rem; margin-top: 0.1rem;"></i>
        <div>
          <strong>Please correct the following errors:</strong>
          <ul>
            <% errors.forEach(err => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>

    <form action="/users" method="POST" id="create-user-form">
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="firstName">First Name <span class="required-star">*</span></label>
          <div class="input-wrapper">
            <i class="fa-regular fa-user input-icon"></i>
            <input 
              type="text" 
              id="firstName" 
              name="firstName" 
              class="form-input" 
              placeholder="e.g. Danish" 
              value="<%= typeof values !== 'undefined' && values.firstName ? values.firstName : '' %>"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="lastName">Last Name</label>
          <div class="input-wrapper">
            <i class="fa-regular fa-user input-icon"></i>
            <input 
              type="text" 
              id="lastName" 
              name="lastName" 
              class="form-input" 
              placeholder="e.g. Khan" 
              value="<%= typeof values !== 'undefined' && values.lastName ? values.lastName : '' %>"
            >
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Email Address <span class="required-star">*</span></label>
        <div class="input-wrapper">
          <i class="fa-regular fa-envelope input-icon"></i>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="e.g. danish@example.com" 
            value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"
            required
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="phone">Phone Number</label>
        <div class="input-wrapper">
          <i class="fa-solid fa-phone input-icon"></i>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-input" 
            placeholder="e.g. +1 555 0192" 
            value="<%= typeof values !== 'undefined' && values.phone ? values.phone : '' %>"
          >
        </div>
      </div>

      <div class="form-actions">
        <a href="/users" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" id="save-user-btn">
          <i class="fa-solid fa-check"></i>
          <span>Save User</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
