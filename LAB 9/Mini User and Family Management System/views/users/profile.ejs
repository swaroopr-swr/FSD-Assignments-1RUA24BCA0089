<%- include('../partials/header') %>

<div class="breadcrumbs">
  <a href="/users"><i class="fa-solid fa-users"></i> Users</a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
  <span><%= user.firstName %> <%= user.lastName || '' %></span>
</div>

<!-- User Profile Hero Section -->
<div class="profile-hero">
  <div class="profile-hero-content">
    <div class="profile-identity">
      <% 
        const initials = ((user.firstName ? user.firstName[0] : '') + (user.lastName ? user.lastName[0] : '')).toUpperCase() || 'U';
      %>
      <div class="profile-avatar-large"><%= initials %></div>
      <div class="profile-details">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <h1><%= user.firstName %> <%= user.lastName || '' %></h1>
          <span class="badge badge-primary">Parent Profile</span>
        </div>
        <div class="profile-quick-stats">
          <div class="stat-item">
            <i class="fa-regular fa-envelope" style="color: var(--primary-light);"></i>
            <span><%= user.email %></span>
          </div>
          <div class="stat-item">
            <i class="fa-solid fa-phone" style="color: var(--accent-cyan);"></i>
            <span><%= user.phone || 'No phone provided' %></span>
          </div>
          <div class="stat-item">
            <i class="fa-solid fa-fingerprint" style="color: var(--text-muted);"></i>
            <span style="font-family: monospace; font-size: 0.8rem;"><%= user._id %></span>
          </div>
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <a href="/users/<%= user._id %>/children-new" class="btn btn-primary" id="add-child-btn">
        <i class="fa-solid fa-child"></i>
        <span>Add Child</span>
      </a>
      <a href="/users/<%= user._id %>/children" class="btn btn-secondary" id="view-children-list-btn" title="View Filtered Children API / List">
        <i class="fa-solid fa-list"></i>
        <span>Children API</span>
      </a>
    </div>
  </div>
</div>

<!-- Children Section -->
<div class="section-header">
  <h2>
    <i class="fa-solid fa-children" style="color: var(--accent-cyan);"></i>
    <span>Children</span>
    <span class="badge <%= children && children.length > 0 ? 'badge-cyan' : 'badge-amber' %>" style="font-size: 0.85rem;">
      <%= children ? children.length : 0 %>
    </span>
  </h2>

  <% if (children && children.length > 0) { %>
    <a href="/users/<%= user._id %>/children-new" class="btn btn-secondary btn-sm">
      <i class="fa-solid fa-plus"></i> Add Another Child
    </a>
  <% } %>
</div>

<% if (!children || children.length === 0) { %>
  <!-- Requirement 7: A valid user has no children -> show "No children found for this user." -->
  <div class="empty-state glass-card" id="no-children-message">
    <div class="empty-state-icon">
      <i class="fa-solid fa-baby-carriage"></i>
    </div>
    <h3>No children found for this user.</h3>
    <p>This user currently has no linked children registered in the family database.</p>
    <a href="/users/<%= user._id %>/children-new" class="btn btn-primary" id="add-first-child-btn">
      <i class="fa-solid fa-plus"></i>
      <span>Add First Child</span>
    </a>
  </div>
<% } else { %>
  <div class="cards-grid">
    <% children.forEach(child => { %>
      <% 
        const childInitials = ((child.firstName ? child.firstName[0] : '') + (child.lastName ? child.lastName[0] : '')).toUpperCase() || 'C';
      %>
      <div class="glass-card interactive-card child-card" id="child-card-<%= child._id %>">
        <div class="child-card-header">
          <div class="child-title-area">
            <div class="avatar child-avatar"><%= childInitials %></div>
            <div>
              <h3 style="font-size: 1.15rem;"><%= child.firstName %> <%= child.lastName || '' %></h3>
              <span style="font-size: 0.8rem; color: var(--text-muted); font-family: monospace;">ID: <%= child._id %></span>
            </div>
          </div>
          <span class="badge badge-cyan"><%= child.age %> <%= child.age === 1 ? 'yr' : 'yrs' %></span>
        </div>

        <div class="info-list">
          <div class="info-item">
            <i class="fa-regular fa-envelope icon"></i>
            <span><%= child.email || 'No email provided' %></span>
          </div>
          <div class="info-item">
            <i class="fa-solid fa-link icon"></i>
            <span style="font-size: 0.75rem; color: var(--accent-emerald);">Linked to <%= user.firstName %></span>
          </div>
        </div>

        <div class="user-card-footer" style="margin-top: 0.5rem; gap: 0.5rem; flex-wrap: wrap;">
          <!-- Thinking Challenge Verification Link: GET /users/:id/children/:childId -->
          <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn btn-secondary btn-sm" title="Verify Parent-Child Relationship" id="view-relation-<%= child._id %>">
            <i class="fa-solid fa-shield-check"></i>
            <span>Verify Link</span>
          </a>

          <!-- Update Option -->
          <a href="/children/<%= child._id %>/edit" class="btn btn-secondary btn-sm" id="edit-child-<%= child._id %>">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>Edit</span>
          </a>

          <!-- Delete Option -->
          <form 
            action="/children/<%= child._id %>?_method=DELETE" 
            method="POST" 
            style="display: inline;" 
            onsubmit="return confirm('Are you sure you want to delete <%= child.firstName %> from MongoDB?');"
            id="delete-form-<%= child._id %>"
          >
            <button type="submit" class="btn btn-danger btn-sm" id="delete-child-<%= child._id %>">
              <i class="fa-solid fa-trash"></i>
              <span>Delete</span>
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
