---
layout: layouts/base.njk
title: Contact & Admissions
subtitle: Get in touch with the Department of Computer Applications for academic inquiries, admissions, or research collaborations.
permalink: /contact.html
metaDescription: Contact the Department of Computer Applications at RV University Bengaluru. Working contact form, campus address, map coordinates, and office hours.
---

<section class="section section-white">
  <div class="container">
    
    <div class="contact-layout">
      
      <!-- Left: Netlify Contact Form with Validation -->
      <div>
        <div class="section-header section-header-left" style="margin-bottom: 2rem;">
          <span class="section-label">Send an Inquiry</span>
          <h2 class="section-title">Get in Touch</h2>
          <p class="section-subtitle">Have questions about admissions, curricula, or campus facilities? Send us a message.</p>
        </div>

        <form id="contactForm" 
              name="contact" 
              method="POST" 
              data-netlify="true" 
              netlify-honeypot="bot-field" 
              class="contact-form"
              novalidate>
          
          <!-- Hidden Netlify Fields -->
          <input type="hidden" name="form-name" value="contact">
          <p style="display: none;" aria-hidden="true">
            <label>Don’t fill this out if you're human: <input name="bot-field"></label>
          </p>

          <!-- Form Feedback Alerts -->
          <div id="formSuccessMessage" class="form-feedback success" role="alert" tabindex="-1">
            <strong>Thank you!</strong> Your message has been received successfully. A department representative will respond to your email within 1–2 business days.
          </div>
          <div id="formErrorMessage" class="form-feedback error" role="alert" tabindex="-1">
            Please correct the highlighted fields before submitting.
          </div>

          <!-- Full Name -->
          <div class="form-group">
            <label for="contactName" class="form-label">Full Name <span style="color: #DC2626;">*</span></label>
            <input type="text" id="contactName" name="name" class="form-input" required placeholder="e.g. Swaroop R" autocomplete="name">
          </div>

          <!-- Email Address -->
          <div class="form-group">
            <label for="contactEmail" class="form-label">Email Address <span style="color: #DC2626;">*</span></label>
            <input type="email" id="contactEmail" name="email" class="form-input" required placeholder="name@example.com" autocomplete="email">
          </div>

          <!-- Phone Number (Optional) -->
          <div class="form-group">
            <label for="contactPhone" class="form-label">Phone Number (Optional)</label>
            <input type="tel" id="contactPhone" name="phone" class="form-input" placeholder="+91 98765 43210" autocomplete="tel">
          </div>

          <!-- Subject / Inquiry Type -->
          <div class="form-group">
            <label for="contactSubject" class="form-label">Inquiry Subject</label>
            <select id="contactSubject" name="subject" class="form-input">
              <option value="BCA Admissions">BCA Admissions & Eligibility</option>
              <option value="Curriculum Inquiry">Academic Curriculum & Syllabus</option>
              <option value="Placement & Internship">Placement & Corporate Partnerships</option>
              <option value="Research Collaboration">Research & Lab Collaboration</option>
              <option value="General Query">General Department Inquiry</option>
            </select>
          </div>

          <!-- Message -->
          <div class="form-group">
            <label for="contactMessage" class="form-label">Your Message <span style="color: #DC2626;">*</span></label>
            <textarea id="contactMessage" name="message" class="form-textarea" rows="4" required placeholder="Please write your questions or comments here..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">
            Send Message →
          </button>
        </form>
      </div>

      <!-- Right: Department Office Details & Embedded Map -->
      <div>
        <div class="section-header section-header-left" style="margin-bottom: 2rem;">
          <span class="section-label">Department Office</span>
          <h2 class="section-title">Visit Our Campus</h2>
          <p class="section-subtitle">Our department office is located within the central academic campus in Bengaluru.</p>
        </div>

        <ul class="office-info-list">
          <li class="office-info-item">
            <div class="office-icon" aria-hidden="true">📍</div>
            <div class="office-item-content">
              <h4>Campus Address</h4>
              <p>{{ site.address }}</p>
            </div>
          </li>

          <li class="office-info-item">
            <div class="office-icon" aria-hidden="true">✉️</div>
            <div class="office-item-content">
              <h4>Email Communications</h4>
              <p>
                Department: <a href="mailto:{{ site.email }}" style="color: var(--color-primary); font-weight: 600;">{{ site.email }}</a><br>
                Admissions: <a href="mailto:admissions@rvu.edu.in" style="color: var(--color-primary); font-weight: 600;">admissions@rvu.edu.in</a>
              </p>
            </div>
          </li>

          <li class="office-info-item">
            <div class="office-icon" aria-hidden="true">📞</div>
            <div class="office-item-content">
              <h4>Telephone Support</h4>
              <p>{{ site.phoneDisplay }} (University Reception)</p>
            </div>
          </li>

          <li class="office-info-item">
            <div class="office-icon" aria-hidden="true">🕒</div>
            <div class="office-item-content">
              <h4>Office Consultation Hours</h4>
              <p>{{ site.officeHours }} (Closed on Sundays & Gazetted Holidays)</p>
            </div>
          </li>
        </ul>

        <!-- Real Embedded Map of RV University -->
        <div class="map-embed-wrapper" role="region" aria-label="Interactive Google Map of RV University Campus">
          <iframe src="{{ site.googleMapsEmbed }}" 
                  title="Google Map location of RV University Bengaluru" 
                  loading="lazy" 
                  referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
          <a href="{{ site.googleMapsDirections }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-teal btn-sm">
            Open in Google Maps ↗
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Testimonials Block on Contact Page (as permitted in Section 3) -->
<section class="section section-muted" aria-labelledby="contact-testimonials-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Student Voices</span>
      <h2 id="contact-testimonials-heading" class="section-title">What Our Students Say</h2>
      <p class="section-subtitle">Real experiences and feedback from students enrolled in the Department of Computer Applications.</p>
    </div>

    <div class="testimonial-grid">
      {% for item in testimonials %}
        <div class="card testimonial-card">
          <p class="testimonial-quote">{{ item.quote }}</p>
          <div class="testimonial-author">
            <img src="/{{ item.image }}" alt="{{ item.name }}" class="testimonial-avatar" width="48" height="48" loading="lazy">
            <div>
              <div class="testimonial-author-name">{{ item.name }}</div>
              <div class="testimonial-author-role">{{ item.role }}</div>
              <div style="font-size: 0.7rem; color: var(--color-accent); font-weight: 600;">{{ item.company }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
