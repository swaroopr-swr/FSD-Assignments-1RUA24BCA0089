---
layout: layouts/base.njk
title: Placements & Careers
subtitle: Connecting students with premier global technology corporations, product innovators, and consulting leaders.
permalink: /placements.html
metaDescription: Placement statistics, recruiters, salary benchmarks, and student achievements at RV University Department of Computer Applications.
---

<section class="section section-white">
  <div class="container">
    
    <!-- Headline Salary & Placement Records -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); md-grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 3.5rem;">
      {% for item in placements.headlineStats %}
        <div class="card" style="text-align: center; border-top: 4px solid var(--color-primary); padding: 2rem 1.25rem;">
          <span class="gallery-category-badge" style="margin: 0 auto 0.75rem auto;">{{ item.tag }}</span>
          <div style="font-family: var(--font-heading); font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 800; color: var(--color-primary); line-height: 1.1; margin-bottom: 0.35rem;">
            {{ item.value }}
          </div>
          <div style="font-weight: 700; color: var(--text-primary); font-size: 1rem; margin-bottom: 0.25rem;">{{ item.label }}</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);">{{ item.description }}</div>
        </div>
      {% endfor %}
    </div>

    <!-- Career Readiness Support Metrics Strip -->
    <div style="background-color: var(--color-primary-dark); color: #FFFFFF; border-radius: var(--radius-md); padding: 2.5rem; margin-bottom: 4.5rem;">
      <div style="text-align: center; max-width: 600px; margin: 0 auto 2rem auto;">
        <span class="section-label" style="color: var(--color-accent-bright);">Preparation & Upskilling</span>
        <h2 style="color: #FFFFFF; font-size: 1.75rem;">Career Transformation Ecosystem</h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; text-align: center;">
        {% for metric in placements.supportMetrics %}
          <div>
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--color-accent-bright); line-height: 1.1; margin-bottom: 0.35rem;">
              {{ metric.count }}
            </div>
            <div style="font-size: 0.95rem; color: #CBD5E1; font-weight: 600;">{{ metric.label }}</div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Recruiter Logo Row (TCS, Infosys, Wipro, Accenture, IBM, Microsoft) -->
    <div style="margin-bottom: 4.5rem;">
      <div class="section-header">
        <span class="section-label">Corporate Partners</span>
        <h2 class="section-title">Top Recruiting Organizations</h2>
        <p class="section-subtitle">Leading global enterprises and technology pioneers actively hiring graduates from our campus.</p>
      </div>

      <div class="recruiter-grid">
        {% for rec in placements.recruiters %}
          <div class="recruiter-card" title="{{ rec.name }} ({{ rec.tier }})">
            <img src="/{{ rec.logo }}" alt="{{ rec.name }} Logo" class="recruiter-logo" width="120" height="44" loading="lazy">
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Student Achievements (3 Cards) -->
    <div id="achievements">
      <div class="section-header">
        <span class="section-label">Student Success</span>
        <h2 class="section-title">Student Achievements & Recognitions</h2>
        <p class="section-subtitle">Celebrating competitive hackathon triumphs, academic university honors, and student-founded startups.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        {% for ach in achievements %}
          <div class="card" style="border-left: 4px solid var(--color-accent-bright); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span class="gallery-category-badge">{{ ach.badge }}</span>
                <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">{{ ach.meta }}</span>
              </div>
              <h3 style="font-size: 1.25rem; color: var(--color-primary); margin-bottom: 0.75rem;">{{ ach.title }}</h3>
              <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 1.5rem;">
                {{ ach.description }}
              </p>
            </div>
            <div style="font-size: 0.8rem; font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.05em;">
              {{ ach.tag }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>
