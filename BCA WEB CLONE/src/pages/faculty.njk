---
layout: layouts/base.njk
title: Faculty Directory
subtitle: Meet our accomplished educators, researchers, and mentors driving computing excellence.
permalink: /faculty.html
metaDescription: Complete faculty directory for the Department of Computer Applications at RV University with designation filter and research area search.
---

<section class="section section-white">
  <div class="container">
    
    <!-- Controls: Search Input + Designation Filter Chips -->
    <div class="faculty-controls" role="region" aria-label="Faculty Search and Filter">
      <div class="search-box-wrapper">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input type="text" 
               id="facultySearch" 
               class="search-input" 
               placeholder="Search by name, specialization, or qualification..." 
               aria-label="Search faculty by name, qualification, or research area">
      </div>

      <div class="filter-chip-group" role="group" aria-label="Filter by Designation">
        <button type="button" class="filter-chip active" data-filter="all">All Faculty</button>
        <button type="button" class="filter-chip" data-filter="professor">Professors</button>
        <button type="button" class="filter-chip" data-filter="associate professor">Associate Professors</button>
        <button type="button" class="filter-chip" data-filter="assistant professor">Assistant Professors</button>
      </div>
    </div>

    <!-- Faculty Cards Grid -->
    <div class="faculty-grid" id="facultyGrid" aria-live="polite">
      {% for member in faculty %}
        <div class="card faculty-card" 
             data-designation="{{ member.designation | lower }}" 
             data-search="{{ member.name }} {{ member.qualification }} {{ member.research }} {{ member.cabin }} {{ member.designation }}">
          <div class="faculty-photo-wrapper">
            <img src="/{{ member.image }}" 
                 alt="Portrait of {{ member.name }}" 
                 class="faculty-photo" 
                 width="320" 
                 height="280" 
                 loading="lazy">
          </div>

          <div style="flex: 1; display: flex; flex-direction: column;">
            <h3 class="faculty-name">{{ member.name }}</h3>
            <div class="faculty-designation">{{ member.designation }}{% if member.isHod %} (HOD){% endif %}</div>

            <ul class="faculty-meta-list">
              <li class="faculty-meta-item">
                <span class="faculty-meta-label">Qualification:</span>
                <span>{{ member.qualification }}</span>
              </li>
              <li class="faculty-meta-item">
                <span class="faculty-meta-label">Cabin / Office:</span>
                <span>{{ member.cabin }}</span>
              </li>
              <li class="faculty-meta-item">
                <span class="faculty-meta-label">Email:</span>
                <span><a href="mailto:{{ member.email }}" style="color: var(--color-primary); word-break: break-all;">{{ member.email }}</a></span>
              </li>
            </ul>

            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem;">Research Focus</div>
              <div class="faculty-research-tag">{{ member.research }}</div>
            </div>
          </div>
        </div>
      {% endfor %}

      <!-- Accessible Empty State -->
      <div id="facultyEmptyState" class="empty-state" style="display: none;" role="status">
        <div class="empty-state-icon" aria-hidden="true">🔎</div>
        <h3 style="font-size: 1.35rem; color: var(--color-primary); margin-bottom: 0.5rem;">No Faculty Members Found</h3>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto;">
          We couldn't find any faculty members matching your search query. Try clearing the search box or selecting a different designation filter.
        </p>
      </div>
    </div>

  </div>
</section>
