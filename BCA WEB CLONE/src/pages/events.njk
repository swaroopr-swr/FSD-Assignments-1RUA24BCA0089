---
layout: layouts/base.njk
title: News & Events
subtitle: Stay informed with the latest seminars, coding marathons, placement drives, and academic achievements.
permalink: /events.html
metaDescription: Keep updated on hackathons, artificial intelligence workshops, guest lectures, and campus recruitment drives at RV University BCA Department.
---

<section class="section section-white">
  <div class="container">
    
    <div class="section-header">
      <span class="section-label">Department Bulletin</span>
      <h2 class="section-title">Seminars, Competitions & Conclaves</h2>
      <p class="section-subtitle">
        Engaging students in vibrant co-curricular activities, hackathons, and industry mentorship sessions throughout the academic year.
      </p>
    </div>

    <div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.75rem;">
      {% for event in events %}
        <div class="card" style="border-left: 4px solid {% if event.status == 'Upcoming' %}var(--color-accent-bright){% else %}var(--color-primary){% endif %}; padding: 2rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="gallery-category-badge">{{ event.category }}</span>
              <span class="filter-chip" style="cursor: default; padding: 0.15rem 0.5rem; font-size: 0.7rem; background-color: {% if event.status == 'Upcoming' %}#FEF3C7{% else %}var(--bg-muted){% endif %}; color: {% if event.status == 'Upcoming' %}#92400E{% else %}var(--text-secondary){% endif %};">
                {{ event.status }}
              </span>
            </div>
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--color-primary); background-color: rgba(11,60,73,0.06); padding: 0.25rem 0.75rem; border-radius: var(--radius-sm);">
              📅 {{ event.date }}
            </div>
          </div>

          <h3 style="font-size: 1.35rem; color: var(--color-primary); margin-bottom: 0.5rem;">{{ event.title }}</h3>
          
          <div style="display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
            <span>⏰ {{ event.time }}</span>
            <span>📍 {{ event.venue }}</span>
          </div>

          <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0;">
            {{ event.description }}
          </p>
        </div>
      {% endfor %}
    </div>

  </div>
</section>
