# Application Port
PORT=3000

# MongoDB Atlas Connection URI
# Note: Verified Access uses its own dedicated database and test database.
# Running `npm run reset:dev -- --confirm` drops the collections in MONGODB_URI to reset data.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/campus_lost_found_verified?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/campus_lost_found_verified_test?retryWrites=true&w=majority

# Secret key for signed cookies (session tracking & registration tickets)
COOKIE_SECRET=change-this-to-a-secure-random-secret

# Admin Office Console Credentials (Environment-only, never stored in DB)
# ADMIN_EMAIL must end with @rvu.admin.in
ADMIN_EMAIL=office@rvu.admin.in
# Generate the scrypt hash using `npm run admin:hash` and paste the output below
ADMIN_PASSWORD_HASH=placeholder_generate_with_npm_run_admin_hash
