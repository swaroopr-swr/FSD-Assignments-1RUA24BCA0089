<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash-banner flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
    <span class="flash-type"><%= flash.type.toUpperCase() %>:</span>
    <span class="flash-message"><%= flash.message %></span>
  </div>
<% } %>
