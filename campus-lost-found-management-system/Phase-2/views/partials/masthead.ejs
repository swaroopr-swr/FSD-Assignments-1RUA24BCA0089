<header class="site-header">
  <div class="container masthead-inner">
    <a href="/" class="masthead-brand">
      <span class="masthead-title">Campus Lost &amp; Found</span>
      <span class="masthead-subline">Property Office</span>
    </a>

    <nav class="masthead-nav" aria-label="Main Navigation">
      <a href="/" class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/lost-items" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/lost-items') ? 'active' : '' %>">Lost Items</a>
      <a href="/found-items" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/found-items') ? 'active' : '' %>">Found Items</a>
      <a href="/report" class="<%= typeof currentPath !== 'undefined' && currentPath === '/report' ? 'active' : '' %>">Report an Item</a>
      <% if (currentStudent) { %>
        <a href="/my-claims" class="<%= typeof currentPath !== 'undefined' && currentPath.startsWith('/my-claims') ? 'active' : '' %>">My Claims</a>
      <% } %>
    </nav>

    <div class="masthead-auth">
      <% if (currentStudent) { %>
        <span>Signed in as <a href="/students/<%= currentStudent._id %>"><strong><%= currentStudent.fullName %></strong></a></span>
        <form method="POST" action="/sign-out">
          <button type="submit" class="btn btn-secondary btn-sm">Sign out</button>
        </form>
      <% } else { %>
        <a href="/sign-in">Sign in</a>
        <span>·</span>
        <a href="/students/new">Register</a>
      <% } %>
    </div>
  </div>
</header>
