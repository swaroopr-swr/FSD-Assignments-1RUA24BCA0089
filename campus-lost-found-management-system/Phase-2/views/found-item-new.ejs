<%- include('partials/head', { title: 'Report Found Item' }) %>
<%- include('partials/masthead') %>

<main class="main-content">
  <div class="container" style="max-width: 760px;">
    <%- include('partials/flash') %>

    <div class="form-card" style="border-top: 4px solid var(--found-blue);">
      <div style="border-bottom: 2px solid var(--ink); padding-bottom: 12px; margin-bottom: 28px;">
        <span class="mono-label" style="color: var(--found-blue);">Receipt Slip · Notice of Discovery</span>
        <h1 style="font-size: 1.9rem; margin: 6px 0 0;">Report a <em>Found Item</em></h1>
      </div>

      <form method="POST" action="/found-items" novalidate>
        <!-- Section 01: The Item -->
        <fieldset class="form-section" style="border: 0; padding: 0;">
          <legend class="form-section-title">01 — The Item</legend>

          <div class="form-group">
            <label for="itemName" class="form-label">Item Name / Title</label>
            <input 
              type="text" 
              id="itemName" 
              name="itemName" 
              value="<%= typeof values !== 'undefined' ? values.itemName || '' : '' %>" 
              class="form-input" 
              placeholder="e.g. Black Titan Wristwatch" 
              required
              <% if (typeof errors !== 'undefined' && errors.itemName) { %>aria-invalid="true" aria-describedby="itemName-error"<% } %>
            >
            <% if (typeof errors !== 'undefined' && errors.itemName) { %>
              <p class="field-error" id="itemName-error"><%= errors.itemName %></p>
            <% } %>
          </div>

          <div class="form-group">
            <span class="form-label">Category (Ballot Selection)</span>
            <div class="ballot-grid" role="radiogroup" aria-label="Item Category">
              <% categories.forEach(function(cat) { %>
                <label class="ballot-option">
                  <input 
                    type="radio" 
                    name="category" 
                    value="<%= cat %>"
                    <%= (typeof values !== 'undefined' && values.category === cat) ? 'checked' : '' %>
                  >
                  <span><%= cat %></span>
                </label>
              <% }); %>
            </div>
            <% if (typeof errors !== 'undefined' && errors.category) { %>
              <p class="field-error" id="category-error"><%= errors.category %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="description" class="form-label">Detailed Description (Appearance, condition, brand, color)</label>
            <textarea 
              id="description" 
              name="description" 
              class="form-textarea" 
              placeholder="Describe distinguishing marks, condition, color, or other notable details..."
              rows="5"
              required
              <% if (typeof errors !== 'undefined' && errors.description) { %>aria-invalid="true" aria-describedby="description-error"<% } %>
            ><%= typeof values !== 'undefined' ? values.description || '' : '' %></textarea>
            <% if (typeof errors !== 'undefined' && errors.description) { %>
              <p class="field-error" id="description-error"><%= errors.description %></p>
            <% } %>
          </div>
        </fieldset>

        <!-- Section 02: Where and When -->
        <fieldset class="form-section" style="border: 0; padding: 0;">
          <legend class="form-section-title">02 — Where and When</legend>

          <div class="form-group">
            <label for="foundLocation" class="form-label">Campus Location Where Found</label>
            <input 
              type="text" 
              id="foundLocation" 
              name="foundLocation" 
              value="<%= typeof values !== 'undefined' ? values.foundLocation || '' : '' %>" 
              class="form-input" 
              placeholder="e.g. Student Canteen, Bench near Counter 3" 
              required
              <% if (typeof errors !== 'undefined' && errors.foundLocation) { %>aria-invalid="true" aria-describedby="foundLocation-error"<% } %>
            >
            <% if (typeof errors !== 'undefined' && errors.foundLocation) { %>
              <p class="field-error" id="foundLocation-error"><%= errors.foundLocation %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="dateFound" class="form-label">Date Found</label>
            <input 
              type="date" 
              id="dateFound" 
              name="dateFound" 
              value="<%= typeof values !== 'undefined' ? values.dateFound || '' : '' %>" 
              class="form-input" 
              required
              max="<%= new Date().toISOString().split('T')[0] %>"
              <% if (typeof errors !== 'undefined' && errors.dateFound) { %>aria-invalid="true" aria-describedby="dateFound-error"<% } %>
            >
            <% if (typeof errors !== 'undefined' && errors.dateFound) { %>
              <p class="field-error" id="dateFound-error"><%= errors.dateFound %></p>
            <% } %>
          </div>
        </fieldset>

        <hr class="perforated-divider">

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
          <a href="/found-items" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary" style="background-color: var(--found-blue); border-color: var(--ink);">File Found Item Slip &rarr;</button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
