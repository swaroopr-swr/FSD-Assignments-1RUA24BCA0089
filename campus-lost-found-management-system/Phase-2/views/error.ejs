<%
  const statusCode = typeof status !== 'undefined' && status ? status : 500;
  const errorTitle = typeof title !== 'undefined' && title ? title : `${statusCode} — Application Error`;
  const errorMsg = typeof message !== 'undefined' && message ? message : 'An unexpected error occurred in the property registry.';
  let defaultSubtitle = 'The office ledger encountered an issue while processing your request.';
  if (statusCode === 400) {
    defaultSubtitle = 'The submission contained invalid or incomplete parameters.';
  } else if (statusCode === 401 || statusCode === 403) {
    defaultSubtitle = 'Access restricted: you do not hold authorization for this office action.';
  } else if (statusCode === 404) {
    defaultSubtitle = 'The requested desk, ledger, or record does not exist in custody.';
  } else if (statusCode === 409) {
    defaultSubtitle = 'State conflict: this record has already been decided, returned, or locked.';
  }
%>
<%- include('partials/head', { title: errorTitle }) %>
<%- include('partials/masthead') %>

<main class="main-content">
  <div class="container">
    <div class="error-box">
      <div class="error-stamp" style="border-color: var(--rust-deep); color: var(--rust-deep);"><%= statusCode %> ERROR</div>
      <h1 style="font-size: 1.8rem; margin-bottom: 16px;"><%= errorMsg %></h1>
      <p style="color: var(--ink-soft); margin-bottom: 32px;">
        <%= typeof subtitle !== 'undefined' && subtitle ? subtitle : defaultSubtitle %>
      </p>
      <div>
        <a href="/" class="btn btn-primary">&larr; Return to Property Office Home</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
