# Application Port
PORT=3000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-host> with your MongoDB Atlas details.
# Ensure the database name is set to campus_lost_found.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/campus_lost_found?retryWrites=true&w=majority

# Secret key for signed cookies
COOKIE_SECRET=change-this-to-a-secure-random-secret
